# Database (Supabase managed PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# JWT Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# AI chat encryption (generate with: openssl rand -base64 32)
AI_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AI_DATA_ENCRYPTION_KEY_VERSION="v1"
AI_DATA_ENCRYPTION_MIGRATE_ON_STARTUP="true"

# Redis (Docker will use redis:6379 internally)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_PREFIX=bull

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_ORG_NAME=your-github-organization
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
BACKEND_URL=https://api.your-domain.example.com

# AI Provider (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Evidence memory limits
EVIDENCE_MAX_PROMPT_SOURCE_BYTES=100000
EVIDENCE_MAX_SOURCE_EXCERPT_BYTES=12000

# Solana (Devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
CREDENTIAL_METADATA_BASE_URL=https://your-public-api.example/solana/credentials/v1
SOLANA_PRIVATE_KEY=your-solana-authority-secret-key-json

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
NODE_ENV=production
# Number of trusted reverse-proxy hops. Leave at 0 unless your deployment has a known proxy chain.
TRUST_PROXY_HOPS=1
