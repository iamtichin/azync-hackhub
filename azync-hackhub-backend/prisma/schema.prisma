generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
}

enum EvidenceType {
  GITHUB_REPOSITORY
  GITHUB_FILE
  GITHUB_TEST_SIGNAL
  SOLANA_TRANSACTION
  SOLANA_ACCOUNT
  DEMO_URL
}

enum EvidenceStatus {
  VERIFIED
  UNVERIFIED
  UNAVAILABLE
}

enum AiContextStatus {
  ACTIVE
  STALE
}

enum AiChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum AiChatRole {
  USER
  ASSISTANT
}

model User {
  id                    String   @id @default(cuid())
  githubId              String   @unique
  githubUsername        String
  email                 String?
  name                  String
  avatarUrl             String?
  university            String?
  skills                String[] @default([])
  accessToken           String?  @db.Text // Encrypted GitHub token
  accessTokenCiphertext String?  @db.Text
  accessTokenIv         String?
  accessTokenAuthTag    String?
  accessTokenKeyVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers          TeamMember[]
  aiChatSessions       AiChatSession[]
  judgingAssignments   HackathonJudge[]
  organizedHackathons  Hackathon[]       @relation("HackathonOrganizer")
  revokedSessions      RevokedSession[]
  assignedTasks        Task[]            @relation("TaskAssignee")
  createdTeamInvites   TeamInvite[]      @relation("TeamInviteCreator")
  usedTeamInvites      TeamInvite[]      @relation("TeamInviteRecipient")
  activities           TeamActivity[]    @relation("ActivityActor")
  submissionDrafts     SubmissionDraft[] @relation("DraftEditor")
  selectedWinnerAwards WinnerAward[]     @relation("WinnerAwardSelector")

  @@index([githubUsername])
}

model RevokedSession {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Team {
  id            String  @id @default(cuid())
  name          String
  hackathonId   String
  walletAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      Submission[]
  members          TeamMember[]
  registrations    HackathonRegistration[]
  areas            Area[]
  tasks            Task[]
  repository       GitHubRepository?
  activities       TeamActivity[]
  submissionDrafts SubmissionDraft[]
  invites          TeamInvite[]

  @@index([hackathonId])
}

model TeamActivity {
  id          String   @id @default(cuid())
  teamId      String
  actorId     String
  action      String
  subjectType String?
  subjectId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt, id])
  @@index([actorId, createdAt])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("member") // "admin" | "member"

  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User  @relation("TeamInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("TeamInviteRecipient", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([teamId, expiresAt])
  @@index([usedById])
}

model Hackathon {
  id          String   @id @default(cuid())
  organizerId String?
  name        String
  description String?  @db.Text
  coverUrl    String?
  isPublished Boolean  @default(false)
  startDate   DateTime
  endDate     DateTime

  rules         Json   @default("[]")
  rubric        Json   @default("[]")
  rulesVersion  String @default("rules-v1")
  rubricVersion String @default("rubric-v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions       Submission[]
  registrations     HackathonRegistration[]
  aiContextSessions AiContextSession[]
  aiChatSessions    AiChatSession[]
  judges            HackathonJudge[]
  tracks            Track[]
  submissionDrafts  SubmissionDraft[]
  winnerAward       WinnerAward?
  organizer         User?                   @relation("HackathonOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([organizerId])
}

model HackathonJudge {
  id          String   @id @default(cuid())
  hackathonId String
  userId      String
  role        String   @default("judge")
  assignedAt  DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([userId])
}

model HackathonRegistration {
  id          String  @id @default(cuid())
  hackathonId String
  teamId      String
  trackId     String?

  registeredAt DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track     Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@unique([hackathonId, teamId])
  @@index([trackId])
}

model Track {
  id          String   @id @default(cuid())
  hackathonId String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon     Hackathon               @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  registrations HackathonRegistration[]
  submissions   Submission[]

  @@unique([hackathonId, name])
  @@index([hackathonId, isActive])
}

model Submission {
  id          String  @id @default(cuid())
  teamId      String
  hackathonId String
  trackId     String?

  projectName                      String
  description                      String  @db.Text
  githubUrl                        String
  demoUrl                          String
  videoUrl                         String?
  slidesUrl                        String?
  participantBlockchainEvidenceUrl String?

  receivedStatus String    @default("RECEIVED")
  mintStatus     String    @default("PENDING")
  aiStatus       String    @default("NOT_QUEUED")
  finalSnapshot  Json?
  finalizedAt    DateTime?
  receiptVersion Int       @default(1)

  walletAddress        String
  transactionSignature String?
  nftAssetId           String?
  metadataHash         String?

  status String @default("pending_nft")

  aiAnalysisCompleted Boolean @default(false)
  aiAnalysisJobId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team              Team                @relation(fields: [teamId], references: [id])
  hackathon         Hackathon           @relation(fields: [hackathonId], references: [id])
  track             Track?              @relation(fields: [trackId], references: [id], onDelete: SetNull)
  solanaTransaction SolanaTransaction?
  aiAnalyses        AiAnalysis[]
  aiJobs            AiJob[]
  evidence          Evidence[]
  artifactVersions  AiArtifactVersion[]
  aiContextSession  AiContextSession?
  aiChatSessions    AiChatSession[]
  winnerAward       WinnerAward?

  @@unique([teamId, hackathonId])
  @@index([teamId])
  @@index([hackathonId])
  @@index([trackId])
  @@index([transactionSignature])
  @@index([status])
}

model SubmissionDraft {
  id          String   @id @default(cuid())
  teamId      String
  hackathonId String
  payload     Json
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  updatedBy User      @relation("DraftEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([teamId, hackathonId])
  @@index([updatedById, updatedAt])
}

model SolanaTransaction {
  id           String @id @default(cuid())
  submissionId String @unique

  signature        String? @unique
  walletAddress    String
  nftAssetId       String?
  merkleTree       String?
  leafIndex        BigInt?
  credentialHash   String?
  metadataUri      String?
  metadataDataHash String?
  metadataCreator  String?
  assetOwner       String?
  network          String  @default("devnet")

  status               String    @default("pending")
  confirmations        Int       @default(0)
  retryCount           Int       @default(0)
  slot                 BigInt?
  lastValidBlockHeight BigInt?
  mintAttemptId        String?
  mintLeaseExpiresAt   DateTime?
  errorMessage         String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([signature])
  @@index([walletAddress])
  @@index([status])
  @@index([credentialHash])
}

model WinnerAward {
  id               String @id @default(cuid())
  hackathonId      String @unique
  submissionId     String @unique
  selectedById     String
  recipientAddress String
  decisionSnapshot Json

  status               String    @default("selected")
  signature            String?   @unique
  nftAssetId           String?
  merkleTree           String?
  leafIndex            BigInt?
  credentialHash       String?   @unique
  metadataUri          String?
  metadataDataHash     String?
  metadataCreator      String?
  assetOwner           String?
  network              String    @default("devnet")
  retryCount           Int       @default(0)
  mintAttemptId        String?
  mintLeaseExpiresAt   DateTime?
  lastValidBlockHeight BigInt?
  slot                 BigInt?
  errorMessage         String?   @db.Text

  selectedAt  DateTime  @default(now())
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hackathon  Hackathon  @relation(fields: [hackathonId], references: [id], onDelete: Restrict)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  selectedBy User       @relation("WinnerAwardSelector", fields: [selectedById], references: [id], onDelete: Restrict)

  @@index([selectedById])
  @@index([status])
}

model AiAnalysis {
  id           String  @id @default(cuid())
  submissionId String
  jobId        String? @unique

  architectureVersion String @default("legacy-v0")
  analysisVersion     String @default("legacy-v0")
  promptVersion       String @default("legacy-v0")
  schemaVersion       String @default("legacy-v0")
  inputHash           String @default("legacy-unversioned")

  provider         String @default("legacy")
  protocol         String @default("legacy")
  requestedModel   String @default("legacy")
  resolvedModel    String @default("legacy")
  output           Json   @default("{}")
  validationReport Json   @default("{}")

  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  costUsd      Decimal? @db.Decimal(12, 6)

  gatewayCorrelationId String?
  gatewaySessionId     String?
  selectedConnectionId String?
  previousAnalysisId   String?
  refreshMode          String  @default("FULL")
  changeManifest       Json    @default("{}")

  // Legacy columns are retained so the migration never silently drops data.
  overallScore Float?
  strengths    String[] @default([])
  improvements String[] @default([])
  briefSummary String?  @db.Text
  rawResponse  Json?

  createdAt DateTime @default(now())

  submission      Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  job             AiJob?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  evidenceLinks   AiAnalysisEvidence[]
  contextSnapshot AiContextSnapshot?

  @@unique([submissionId, inputHash, promptVersion, schemaVersion])
  @@index([submissionId, createdAt])
}

model AiJob {
  id             String      @id @default(cuid())
  submissionId   String
  bullmqJobId    String      @unique
  idempotencyKey String      @unique
  status         AiJobStatus @default(QUEUED)

  architectureVersion String
  analysisVersion     String
  promptVersion       String
  schemaVersion       String
  requestFingerprint  String
  sourceRevision      String?
  inputHash           String?

  attempts         Int     @default(0)
  maxAttempts      Int
  errorCode        String?
  errorMessage     String? @db.Text
  validationReport Json?

  requestedModel       String?
  resolvedModel        String?
  protocol             String?
  gatewayCorrelationId String?
  gatewaySessionId     String?
  selectedConnectionId String?

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  submission Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  analysis   AiAnalysis?

  @@index([submissionId, queuedAt])
  @@index([status, queuedAt])
}

model Evidence {
  id               String         @id @default(cuid())
  submissionId     String
  snapshotKey      String         @unique
  type             EvidenceType
  source           String
  status           EvidenceStatus
  reference        String         @db.Text
  sourceRevision   String?
  locator          Json
  facts            Json
  contentHash      String?
  collectorVersion String
  errorCode        String?
  collectedAt      DateTime       @default(now())
  expiresAt        DateTime?

  submission    Submission                  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  analysisLinks AiAnalysisEvidence[]
  contextLinks  AiContextSnapshotEvidence[]
  chatLinks     AiChatMessageEvidence[]

  @@index([submissionId, type])
  @@index([status, collectedAt])
}

model AiAnalysisEvidence {
  analysisId String
  evidenceId String

  analysis AiAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([analysisId, evidenceId])
}

model AiContextSession {
  id                 String          @id @default(cuid())
  submissionId       String          @unique
  hackathonId        String
  status             AiContextStatus @default(ACTIVE)
  contextVersion     Int             @default(0)
  latestRevision     String?
  latestSnapshotHash String?
  lastAnalyzedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  submission   Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  hackathon    Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  snapshots    AiContextSnapshot[]
  chatSessions AiChatSession[]

  @@index([hackathonId, updatedAt])
}

model AiContextSnapshot {
  id               String   @id @default(cuid())
  sessionId        String
  version          Int
  sourceRevision   String?
  snapshotHash     String
  rulesVersion     String
  rubricVersion    String
  context          Json
  delta            Json
  parentSnapshotId String?
  refreshMode      String   @default("FULL")
  changeManifest   Json     @default("{}")
  analysisId       String?  @unique
  createdAt        DateTime @default(now())

  session       AiContextSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  analysis      AiAnalysis?                 @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  evidenceLinks AiContextSnapshotEvidence[]
  artifactLinks AiContextSnapshotArtifact[]

  @@unique([sessionId, version])
  @@unique([sessionId, snapshotHash])
  @@index([sessionId, createdAt])
}

model AiArtifactVersion {
  id             String   @id @default(cuid())
  submissionId   String
  artifactKey    String
  type           String
  source         String
  reference      String   @db.Text
  path           String?
  sourceRevision String
  contentHash    String
  content        String   @db.Text
  metadata       Json     @default("{}")
  status         String   @default("CURRENT")
  supersedesId   String?
  createdAt      DateTime @default(now())

  submission    Submission                  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  snapshotLinks AiContextSnapshotArtifact[]

  @@unique([submissionId, artifactKey, sourceRevision, contentHash])
  @@index([submissionId, status, type])
  @@index([submissionId, sourceRevision])
}

model AiContextSnapshotArtifact {
  snapshotId String
  artifactId String

  snapshot AiContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  artifact AiArtifactVersion @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([snapshotId, artifactId])
}

model AiContextSnapshotEvidence {
  snapshotId String
  evidenceId String

  snapshot AiContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  evidence Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([snapshotId, evidenceId])
}

model AiChatSession {
  id                String              @id @default(cuid())
  submissionId      String
  hackathonId       String
  contextSessionId  String
  judgeId           String
  title             String?
  titleCiphertext   String?             @db.Text
  titleIv           String?
  titleAuthTag      String?
  encryptedDek      String?             @db.Text
  dekIv             String?
  dekAuthTag        String?
  encryptionVersion String?
  status            AiChatSessionStatus @default(ACTIVE)
  contextVersion    Int                 @default(0)
  rulesVersion      String
  rubricVersion     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  submission     Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  hackathon      Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  contextSession AiContextSession @relation(fields: [contextSessionId], references: [id], onDelete: Cascade)
  judge          User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  messages       AiChatMessage[]

  @@index([submissionId, judgeId, updatedAt])
  @@index([hackathonId, judgeId, updatedAt])
}

model AiChatMessage {
  id                String     @id @default(cuid())
  sessionId         String
  role              AiChatRole
  content           String?    @db.Text
  contentCiphertext String?    @db.Text
  contentIv         String?
  contentAuthTag    String?
  encryptionVersion String?
  contextVersion    Int
  model             String?
  inputTokens       Int        @default(0)
  outputTokens      Int        @default(0)
  latencyMs         Int        @default(0)
  correlationId     String?
  createdAt         DateTime   @default(now())

  session       AiChatSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidenceLinks AiChatMessageEvidence[]

  @@index([sessionId, createdAt])
}

model AiChatMessageEvidence {
  messageId  String
  evidenceId String

  message  AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  evidence Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([messageId, evidenceId])
}

model Area {
  id             String @id @default(cuid())
  teamId         String
  name           String
  color          String
  estimatedHours Float  @default(0)
  actualHours    Float  @default(0)
  displayOrder   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([teamId])
}

model Task {
  id     String  @id @default(cuid())
  teamId String
  areaId String?

  title          String
  description    String? @db.Text
  estimatedHours Float   @default(0)
  actualHours    Float   @default(0)

  status   String @default("todo") // "backlog" | "todo" | "in_progress" | "blocked" | "done"
  priority String @default("medium") // "high" | "medium" | "low"

  isCriticalPath Boolean @default(false)
  assigneeId     String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  area         Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("BlockedBy")
  blockers     TaskDependency[] @relation("Blocks")

  @@index([teamId, status])
  @@index([areaId])
  @@index([assigneeId])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  createdAt DateTime @default(now())

  task      Task @relation("BlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("Blocks", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model GitHubRepository {
  id     String @id @default(cuid())
  teamId String @unique

  fullName               String // "azync-hackhub-contests/team-123-repo"
  url                    String
  webhookConfigured      Boolean             @default(false)
  webhookError           String?             @db.Text
  provisioningStatus     String              @default("READY")
  provisioningError      String?             @db.Text
  collaborators          Json                @default("[]")
  isPrivate              Boolean             @default(true)
  lastWebhookAt          DateTime?
  lastPushAt             DateTime?
  lastCommitSha          String?
  lastPullRequestAt      DateTime?
  lastWorkflowRunAt      DateTime?
  lastWorkflowStatus     String?
  lastWorkflowConclusion String?
  workflowRuns           GitHubWorkflowRun[]

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model GitHubWorkflowRun {
  id               String    @id @default(cuid())
  repositoryId     String
  runId            String
  runAttempt       Int
  headSha          String
  headBranch       String
  triggerEvent     String
  status           String
  conclusion       String?
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime
  testStatus       String    @default("UNKNOWN")
  coverageStatus   String    @default("UNKNOWN")
  trustLimitations Json
  receivedAt       DateTime  @default(now())

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, runId, runAttempt])
  @@index([repositoryId, updatedAt])
}

model GitHubWebhookDelivery {
  id                   String    @id @default(cuid())
  deliveryId           String    @unique
  event                String
  hookId               String?
  repositoryFullName   String?
  payloadHash          String
  status               String    @default("PROCESSING")
  processingLeaseUntil DateTime?
  result               Json?
  errorCode            String?
  errorMessage         String?   @db.Text
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?

  @@index([status, receivedAt])
  @@index([repositoryFullName, receivedAt])
}
