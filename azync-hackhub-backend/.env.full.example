# PostgreSQL (DATABASE_URL is generated by docker-compose.full.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=azync_hackhub
# DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/azync_hackhub?schema=public

# Application
NODE_ENV=production
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AI_DATA_ENCRYPTION_KEY_VERSION=v1
AI_DATA_ENCRYPTION_MIGRATE_ON_STARTUP=true
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://api.your-domain.example.com

# Redis (internal Docker service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# GitHub OAuth, repository automation, and webhooks
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://api.your-domain.example.com/auth/github/callback
GITHUB_TOKEN=your-github-token
GITHUB_ORG_NAME=your-github-organization
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# AI provider compatibility variables
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=

# AI routing used by the current AI Layer
OMNIROUTE_BASE_URL=https://your-ai-gateway.example.com
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_PRIMARY_PROTOCOL=anthropic
OMNIROUTE_PRIMARY_MODEL=azync-analysis-v1
OMNIROUTE_FALLBACK_PROTOCOL=openai
OMNIROUTE_FALLBACK_MODEL=
OMNIROUTE_REQUEST_TIMEOUT_MS=45000
OMNIROUTE_MAX_RESPONSE_BYTES=1000000
AI_MAX_OUTPUT_TOKENS=8000
AI_JOB_ATTEMPTS=3
AI_QUEUE_CONCURRENCY=2

# Evidence collection limits
DEMO_PROBE_TIMEOUT_MS=10000
DEMO_PROBE_MAX_BYTES=256000
DEMO_PROBE_MAX_REDIRECTS=3
EVIDENCE_GITHUB_TIMEOUT_MS=10000
EVIDENCE_MAX_PROMPT_SOURCE_BYTES=100000
EVIDENCE_MAX_SOURCE_EXCERPT_BYTES=12000

# Solana / Bubblegum compressed NFTs
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
CREDENTIAL_METADATA_BASE_URL=https://your-public-api.example/solana/credentials/v1
SOLANA_AUTHORITY_SECRET_KEY=your-solana-authority-secret-key-json
SOLANA_AUTHORITY_PUBLIC_KEY=your-solana-authority-public-key
SOLANA_MERKLE_TREE_ADDRESS=your-solana-merkle-tree-address
# Legacy compatibility, if another script still consumes it:
SOLANA_PRIVATE_KEY=your-solana-authority-secret-key-json
